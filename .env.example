# Public application configuration. Both values are explicit; the app has no
# implicit runtime mode or localhost readiness fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Deployment surface. Leave blank for the complete OS; use `host` for the
# reservation and guest-CRM-only staff application.
NEXT_PUBLIC_APP_SURFACE=

# Optional hosted-playground gate. Set the mode to `preview` only when Vercel
# supplies VERCEL_ENV=preview, or to `production-playground` only when Vercel
# supplies VERCEL_ENV=production. Do not set VERCEL_ENV yourself. All three
# values below are server-only; leave them blank for the local demo and for
# normal Supabase-connected environments.
#
# The user registry must contain the four required playground principals and
# salted scrypt password hashes. Never place plaintext passwords, real hashes, or a real
# session secret in this tracked example (or any other tracked file).
LE_YARD_PLAYGROUND_MODE=
LE_YARD_PLAYGROUND_SESSION_SECRET=
LE_YARD_PLAYGROUND_USERS_JSON=
# Optional additional Donald playground login. Store only a salted scrypt hash.
LE_YARD_PLAYGROUND_DONALD_PASSWORD_HASH=

# Single-owner beta. Keep disabled until the selected subscription provider is
# authenticated and its end-to-end proposal/confirmation/undo test has passed.
LE_YARD_OWNER_INTELLIGENCE_ENABLED=false
# `codex_subscription` uses the local official Codex runtime.
# `sub2api_subscription` uses a self-hosted Sub2API OpenAI-compatible gateway.
LE_YARD_OWNER_INTELLIGENCE_PROVIDER=codex_subscription
# Optional override. On macOS the ChatGPT app's bundled Codex runtime is found automatically.
LE_YARD_CODEX_BINARY_PATH=
# Server-only. HTTP is accepted only for localhost; every remote gateway must use HTTPS.
LE_YARD_SUB2API_BASE_URL=
LE_YARD_SUB2API_API_KEY=
LE_YARD_SUB2API_MODEL=gpt-5.6-luna

# Keep false until a leased manual-CSV processor has been deployed and its
# source-specific mapping contracts have passed connected acceptance.
LE_YARD_MANUAL_CSV_PROCESSOR_ENABLED=false

# Supabase (publishable values may be exposed to the browser). All three
# values are required when NEXT_PUBLIC_DEMO_MODE=false.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Connected release acceptance exists only on an isolated Vercel Preview backed
# by an isolated Supabase fixture. These values never belong in Production.
# VERCEL_ENV and VERCEL_GIT_COMMIT_SHA are supplied by Vercel; do not set them.
# Non-Vercel releases may set this to the exact immutable Git commit SHA.
LE_YARD_RELEASE_SHA=
CONNECTED_ACCEPTANCE_ATTESTATION_ENABLED=false
CONNECTED_ACCEPTANCE_ATTESTATION_SECRET=
CONNECTED_ACCEPTANCE_TARGET_ID=
CONNECTED_ACCEPTANCE_SCHEMA_VERSION=
CONNECTED_ACCEPTANCE_FIXTURE_ID=
CONNECTED_ACCEPTANCE_FIXTURE_REVISION=

# Public booking API. The signing secret must be a dedicated random value in
# connected production. The website stores its API client key server-side.
BOOKING_SLOT_SIGNING_SECRET=
RESERVATION_LINK_SIGNING_SECRET=
# Emergency negative gate for new public inventory and bookings. False pauses
# new inventory; true or unset only removes the emergency pause and never
# authorizes booking without the database location release control. Existing
# confirmation and management recovery paths remain available while false.
RESERVATION_PUBLIC_BOOKING_ENABLED=false
# Layered public booking abuse ceilings. Defaults are 2x each per-identity
# route limit globally and 4 create attempts per normalized contact per hour.
BOOKING_GLOBAL_RATE_LIMIT_MULTIPLIER=2
BOOKING_CONTACT_RATE_LIMIT_PER_HOUR=4
# Public guest-interest submissions are also limited by normalized contact.
GUEST_INTEREST_CONTACT_RATE_LIMIT_PER_HOUR=6
# Dedicated server-only HMAC and worker secrets for destination verification.
GUEST_INTEREST_VERIFICATION_SECRET=
IDENTITY_DELIVERY_SECRET=

# Guest delivery adapters. Leave both channels disabled in reservation settings
# until approved credentials and sender identities are configured.
RESEND_API_KEY=
LE_YARD_TRANSACTIONAL_EMAIL_FROM="Le Yard <office@send.leyardny.com>"
RESERVATION_EMAIL_FROM="Le Yard Reservations Team <reservations@send.leyardny.com>"
RESERVATION_EMAIL_REPLY_TO=reservations@leyardny.com
RESERVATION_PUBLIC_SITE_URL=
# Hard kill switch: credentials alone never activate SMS. Keep false until the
# documented duplicate-risk release gate is explicitly cleared.
RESERVATION_SMS_DELIVERY_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Production SMS remains disabled until crash-after-provider-acceptance duplicate
# risk is mitigated or explicitly accepted; the Twilio create call is not treated
# as an idempotent outbox completion boundary.
RESERVATION_DELIVERY_SECRET=
RESERVATION_DELIVERY_FORCE_FAILURE=

# Optional transactional email and push configuration
# Hard kill switch: VAPID credentials and the location setting cannot activate
# reservation push delivery unless this value is exactly true.
RESERVATION_PUSH_DELIVERY_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=

# Optional integration adapters. Toast Labor becomes active only when every
# Toast value below is configured and the authenticated worker is scheduled.
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
TOAST_LOCATION_ID=
TOAST_LABOR_SYNC_SECRET=
# Use only Toast's production or sandbox API origin.
TOAST_API_BASE_URL=https://ws-api.toasttab.com
RESY_INTEGRATION_TOKEN=

# Owner bootstrap inputs (production only)
OWNER_1_EMAIL=
OWNER_1_DISPLAY_NAME=
OWNER_2_EMAIL=
OWNER_2_DISPLAY_NAME=
# One-run confirmation emitted by the dry-run bootstrap plan. Do not persist it.
LE_YARD_BOOTSTRAP_CONFIRM=

# Connected Playwright variables belong only in an untracked test-runner secret
# store. `npm run test:e2e:connected` sets release-acceptance mode and requires
# every value below after the signed preview/database preflight succeeds.
E2E_CONNECTED_APP_URL=
E2E_CONNECTED_ENVIRONMENT=
E2E_CONNECTED_ATTESTATION_SECRET=
E2E_CONNECTED_TARGET_ID=
E2E_CONNECTED_EXPECTED_DEPLOYMENT_COMMIT=
E2E_CONNECTED_EXPECTED_SCHEMA_VERSION=
E2E_CONNECTED_FIXTURE_ID=
E2E_CONNECTED_FIXTURE_REVISION=
E2E_CONNECTED_EXPECTED_ORGANIZATION_NAME=
E2E_CONNECTED_EXPECTED_LOCATION_NAME=
E2E_CONNECTED_OWNER_EMAIL=
E2E_CONNECTED_OWNER_PASSWORD=
E2E_CONNECTED_MANAGER_EMAIL=
E2E_CONNECTED_MANAGER_PASSWORD=
E2E_CONNECTED_HOST_EMAIL=
E2E_CONNECTED_HOST_PASSWORD=
E2E_CONNECTED_VIEW_ONLY_EMAIL=
E2E_CONNECTED_VIEW_ONLY_PASSWORD=
E2E_CONNECTED_OPERATE_ONLY_EMAIL=
E2E_CONNECTED_OPERATE_ONLY_PASSWORD=
E2E_CONNECTED_DENIED_EMAIL=
E2E_CONNECTED_DENIED_PASSWORD=
E2E_CONNECTED_EXPIRED_EMAIL=
E2E_CONNECTED_EXPIRED_PASSWORD=
E2E_CONNECTED_CROSS_LOCATION_EMAIL=
E2E_CONNECTED_CROSS_LOCATION_PASSWORD=
