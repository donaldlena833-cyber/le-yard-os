{
  "name": "le-yard-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db:pglite": "node scripts/verify-migrations-pglite.mjs",
    "test:bootstrap:pglite": "node scripts/verify-owner-bootstrap-pglite.mjs",
    "test:people-config:pglite": "node scripts/verify-people-configuration-pglite.mjs",
    "test:inventory-catalog:pglite": "node scripts/verify-inventory-catalog-pglite.mjs",
    "test:operations-config:pglite": "node scripts/verify-operations-security-configuration-pglite.mjs",
    "test:financial-config:pglite": "node scripts/verify-financial-retention-configuration-pglite.mjs",
    "test:integration": "npm run test:db:pglite && npm run test:bootstrap:pglite && npm run test:people-config:pglite && npm run test:inventory-catalog:pglite && npm run test:operations-config:pglite && npm run test:financial-config:pglite",
    "types:database": "node scripts/generate-database-types.mjs",
    "types:database:check": "node scripts/generate-database-types.mjs --check",
    "test:rls": "supabase test db",
    "test:e2e": "playwright test",
    "test:e2e:connected": "playwright test --config playwright.connected.config.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:db:lint": "supabase db lint --local --schema public --level error --fail-on error",
    "bootstrap:owners": "node scripts/bootstrap-initial-owners.mjs",
    "verify": "npm run lint && npm run types:database:check && npm run typecheck && npm run test && npm run test:integration && npm run build",
    "verify:full": "npm run verify && npm run test:e2e && npm audit --audit-level=high",
    "verify:connected": "npm run verify:full && npm run test:rls && npm run test:db:lint && npm run test:e2e:connected"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
